{
    "baseBranches": [
        "master"
    ],
    "rebaseWhen": "conflicted",
    "labels": [
        "dependencies"
    ],
    "gitAuthor": "Renovate Bot <bot@renovateapp.com>",
    "automergeStrategy": "merge-commit",
    "packageRules": [
        {
            "matchPackageNames": ["github-action", "renovatebot/github-action"],
            "ignoreTests": true,
            "automerge": true
        }
    ],
    "regexManagers": [
        {
          "fileMatch": ["\\.yaml$"],
          "matchStrings": [
            "# ?renovate datasource=(?<datasource>.+?) depName=(?<depName>.+)\\n.+: [\"']?(?<currentValue>.+?)[\"']?\\n"
          ]
        }
    ]
}
